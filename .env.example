# ---------------------------------------------------------------------------
# Portfolio backend configuration.
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------

# Human-readable application name (shown in docs and logs).
APP_NAME=Portfolio API

# Semantic version string reported by GET /health.
APP_VERSION=0.1.0

# Runtime environment: "dev" or "prod".
#   dev  -> verbose human-readable logs, /docs enabled, SQLite fallback allowed.
#   prod -> JSON logs, /docs & /redoc disabled, required secrets enforced.
ENVIRONMENT=dev

# Verbose debugging (SQL echo, DEBUG-level logs). Keep false in production.
DEBUG=true

# --- Database ---------------------------------------------------------------

# Async SQLAlchemy DSN. MUST use an async driver.
#   Local dev (default fallback if unset): sqlite+aiosqlite:///./portfolio.db
#   Production:                            postgresql+asyncpg://user:pass@host:5432/dbname
# In prod the app refuses to start with a sqlite URL.
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db

# --- CORS -------------------------------------------------------------------

# Comma-separated list of allowed frontend origins (no trailing slash).
# Example (prod): https://your-portfolio.vercel.app,https://www.yoursite.com
# When this is empty or contains "*", credentials are disabled automatically.
CORS_ORIGINS=http://localhost:3000

# --- Proxy ------------------------------------------------------------------

# Trust the X-Forwarded-For header for the client IP (used by rate limiting).
# Enable ONLY when running behind a proxy you control (e.g. Nginx, a cloud LB);
# otherwise clients can spoof their IP. Leave false for direct exposure.
TRUST_PROXY=false

# --- Secrets ----------------------------------------------------------------

# Bearer token guarding write/admin endpoints. REQUIRED in production
# (the app fails to start if empty when ENVIRONMENT=prod). Use a long random value.
ADMIN_TOKEN=

# --- Uploads -----------------------------------------------------------------

# Where admin-uploaded images are written and served back from.
#
# LEAVE THIS COMMENTED OUT under Docker (both compose files). The image already
# points at /data/uploads, and that path is where the persistent volume is
# mounted; a value here would override it and put the images back inside the
# container, which every `up --build` throws away — leaving the database rows
# pointing at files that no longer exist.
#
# Set it only for a local run without Docker (`uvicorn app.main:app --reload`),
# where a folder in the project is the natural place:
#
#   UPLOAD_DIR=./uploads
#
# In production the app logs a warning at startup if this path is not a mount
# point, which is the symptom of exactly that mistake.

# Ceiling for an INCOMING file, in megabytes. What gets stored is much smaller:
# every upload is re-encoded into a 1600px and a 600px WebP, so a 15 MB photo
# lands as a few hundred kilobytes. Applies to images only; videos have their own
# limit below.
MAX_UPLOAD_MB=15

# Videos (mp4, webm, mov) are stored unchanged on the upload volume and served
# with Range support. Upper bound per file, in MB. The reverse proxy must allow
# bodies this large too — for nginx, in the server block:
#
#   client_max_body_size 2048m;
#   proxy_request_buffering off;   # stream to the app instead of to nginx's disk
#   proxy_read_timeout 600s;       # big uploads on a slow link take a while
MAX_VIDEO_UPLOAD_MB=2048

# A video upload is refused if it would leave less than this much free space.
MIN_FREE_DISK_MB=2048

# --- Telegram notifications (optional) --------------------------------------

# Bot token from @BotFather. Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=

# Chat/channel ID that should receive notifications. Leave empty to disable.
TELEGRAM_CHAT_ID=
